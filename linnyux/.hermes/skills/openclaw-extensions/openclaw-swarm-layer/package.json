    "build": {
      "openclawVersion": "2026.5.3-1"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "openclaw": "^2026.3.22"
  }
}
