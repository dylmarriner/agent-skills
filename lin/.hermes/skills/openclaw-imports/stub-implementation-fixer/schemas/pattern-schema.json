{"title": "Stub Implementation Pattern Configuration", "description": "Custom pattern definitions for detecting stub implementations", "type": "object", "patternProperties": {"^[a-zA-Z][a-zA-Z0-9_]*$": {"type": "object", "properties": {"pattern": {"type": "string", "description": "Regular expression pattern to match", "example": "TODO|FIXME|XXX"}, "priority": {"type": "string", "enum": ["critical", "high", "medium", "low"], "description": "Priority level for issues found with this pattern", "default": "medium"}, "category": {"type": "string", "enum": ["dev-marker", "mock-data", "placeholder", "scaffolded", "implementation-gap", "simplified", "documentation"], "description": "Category for organizing issues", "default": "placeholder"}, "description": {"type": "string", "description": "Human-readable description of what this pattern finds", "example": "Development TODO and FIXME markers"}, "enabled": {"type": "boolean", "description": "Whether this pattern is enabled", "default": true}, "customFilter": {"type": "object", "description": "Custom filtering rules for this pattern", "properties": {"minFileSize": {"type": "number", "description": "Minimum file size to consider (in bytes)"}, "excludeExtensions": {"type": "array", "items": {"type": "string", "description": "File extensions to exclude"}, "example": [".md", ".txt"]}, "requireContext": {"type": "array", "items": {"type": "string", "description": "Context strings that must be present"}, "example": ["TODO", "implementation"]}}, "required": ["pattern"], "additionalProperties": false}}}, "required": ["pattern"], "additionalProperties": false}
